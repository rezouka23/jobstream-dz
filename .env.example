# Use exactly one Google credential source. Never commit the referenced file.
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# API read configuration.
SPREADSHEET_ID=your_google_spreadsheet_id
SHEET_NAME=jobs

# Scraper write configuration. Use the same Sheet values as above.
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SHEET_NAME=jobs
SCRAPER_SOURCES=emploitic,naukrigulf,jobindz,ouedkniss
SCRAPER_INTERVAL_SECONDS=1800
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_REQUEST_DELAY=0.2
SCRAPER_STATE_FILE=.jobstream-scraper-state.json

# Optional LinkedIn adapter. Install python-jobspy before enabling it.
SCRAPER_ENABLE_LINKEDIN=false
LINKEDIN_SEARCH_TERMS=software developer,customer support,marketing,finance
LINKEDIN_HOURS_OLD=168
LINKEDIN_RESULTS_WANTED=50
LINKEDIN_REMOTE_ONLY=false

# API result limits.
FEED_DAYS=7
FEED_LIMIT=10
JOBS_MAX_DAYS=7
JOBS_LIMIT=150

# CV Match. Leave OPENAI_API_KEY empty to keep this endpoint disabled.
OPENAI_API_KEY=
CV_MATCH_MODEL=gpt-4o-mini
CV_MATCH_DAYS=7
CV_MATCH_LIMIT=20
CV_MATCH_MAX_FILE_MB=5
CV_MATCH_TEXT_CHAR_LIMIT=12000
CV_MATCH_RATE_LIMIT_REQUESTS=3
CV_MATCH_RATE_LIMIT_WINDOW_SECONDS=3600
